#!/usr/bin/env bash
# DFIR Triage Agent - WSL launcher (dfir-triage.py selects the interpreter recorded by setup.sh)
# resolve symlinks so the launcher also works when linked into a PATH folder (e.g. /usr/local/bin)
DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export PYTHONDONTWRITEBYTECODE=1
exec python3 "$DIR/dfir-triage.py" "$@"
